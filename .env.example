# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Contact form (server-side only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "IbraHybrid <contact@ibrahybrid.me>"
CONTACT_FROM_EMAIL=
# Where messages are delivered (defaults to ibrahim@zanhybrid.co.tz)
CONTACT_TO_EMAIL=ibrahim@zanhybrid.co.tz

# Optional privacy-friendly analytics (cookieless). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
